NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Fichero SQLite con la última información obtenida (relativo a la raíz del repositorio o absoluto)
DATABASE_PATH=data/weatherdash.db

# Localidad principal y localidad de respaldo (se usa si la principal no se encuentra mediante geocoding)
WEATHER_LOCATION_NAME=Navaluenga
WEATHER_FALLBACK_LOCATION_NAME=Ávila
WEATHER_COUNTRY=España
# Código ISO 3166-1 alpha-2 para acotar la búsqueda de geocoding
WEATHER_COUNTRY_CODE=ES
# Si se indican latitud y longitud no se realiza geocoding
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_TIMEZONE=Europe/Madrid

# Periodo de validez de la caché meteorológica en milisegundos (15 minutos)
WEATHER_REFRESH_INTERVAL=900000
# Timeout de las peticiones a Open-Meteo en milisegundos
WEATHER_REQUEST_TIMEOUT=8000

# Tiempo entre cambios de vista de la interfaz en milisegundos (2,5 minutos). 0 desactiva la rotación; mínimo 10000.
UI_ROTATION_INTERVAL=150000
# Tiempo que cada noticia permanece resaltada en milisegundos (1 minuto); mínimo 5000.
UI_NEWS_ITEM_DURATION=60000
# Bloquea la pantalla mostrada, sin rotación de vistas ni diapositivas (útil para pruebas visuales). 0 = todas.
# En news-* las noticias del feed siguen rotando según UI_NEWS_ITEM_DURATION.
# Opciones: 0 | weather-1 (tiempo y semana) | weather-2 (viento, aire y próximas horas)
#           | news-national | news-international | news-economy | news-markets
UI_PINNED_SCREEN=0

# Feeds RSS: Europa Press (Nacional e Internacional) y Expansión (Economía y Mercados)
NEWS_FEED_NATIONAL_URL=https://www.europapress.es/rss/rss.aspx?ch=66
NEWS_FEED_INTERNATIONAL_URL=https://www.europapress.es/rss/rss.aspx?ch=69
NEWS_FEED_ECONOMY_URL=https://e00-expansion.uecdn.es/rss/economia.xml
NEWS_FEED_MARKETS_URL=https://e00-expansion.uecdn.es/rss/mercados.xml
# Cada cuánto se consultan los feeds en milisegundos (1 hora); mínimo 60000.
NEWS_REFRESH_INTERVAL=3600000
# Noticias de cada rotación de un feed: las que elige la base de datos y las que muestra la lista lateral (1-20).
NEWS_ROTATION_SIZE=5
